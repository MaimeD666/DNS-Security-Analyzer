{
  "schema_version": 2,
  "window_sizes": [
    60,
    300
  ],
  "min_queries": 10,
  "rules": {
    "min_signals": 2,
    "thresholds": {
      "mean_subdomain_length": 40,
      "mean_entropy": 3.5,
      "unique_ratio": 0.8,
      "query_rate": 1.0,
      "txt_ratio": 0.3
    }
  },
  "model": {
    "threshold": 0.5,
    "hidden_layer_sizes": [
      16,
      8
    ],
    "activation": "relu",
    "solver": "lbfgs",
    "max_iter": 1000,
    "random_state": 42
  }
}
